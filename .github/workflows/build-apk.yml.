
name: Build HOME WITH HER APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Extract project ZIP if needed
        shell: bash
        run: |
          if [ ! -f settings.gradle.kts ]; then
            ZIP_FILE=$(find . -maxdepth 2 -type f -name '*.zip' | head -n 1)

            if [ -z "$ZIP_FILE" ]; then
              echo "ERROR: settings.gradle.kts tidak ditemukan dan ZIP proyek tidak ada."
              exit 1
            fi

            mkdir -p extracted
            unzip -q "$ZIP_FILE" -d extracted

            PROJECT_FILE=$(find extracted -type f -name settings.gradle.kts | head -n 1)

            if [ -z "$PROJECT_FILE" ]; then
              echo "ERROR: ZIP tidak berisi settings.gradle.kts."
              exit 1
            fi

            PROJECT_DIR=$(dirname "$PROJECT_FILE")
            cp -a "$PROJECT_DIR"/. .
          fi

      - name: Build debug APK
        run: |
          chmod +x gradlew 2>/dev/null || true

          if [ -f gradlew ]; then
            ./gradlew assembleDebug --no-daemon
          else
            echo "ERROR: gradlew tidak ditemukan."
            exit 1
          fi

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: HOME-WITH-HER-debug-apk
          path: app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
